# Copy to ~/.gradle/gradle.properties (recommended). Do NOT commit secrets.

# --- Maven Central (central.sonatype.com user token) ---
mavenCentralUsername=YOUR_CENTRAL_PORTAL_USERNAME
mavenCentralPassword=YOUR_CENTRAL_PORTAL_TOKEN

# --- GPG signing (choose ONE approach) ---

# Option A: in-memory key (recommended for CI)
# Export with: gpg --export-secret-keys --armor YOUR_KEY_ID
# signingInMemoryKeyId=YOUR_KEY_ID
# signingInMemoryKey=-----BEGIN PGP PRIVATE KEY BLOCK-----\n...\n-----END PGP PRIVATE KEY BLOCK-----
# signingInMemoryKeyPassword=YOUR_KEY_PASSWORD

# Option B: local keyring (GnuPG 2.x uses ~/.gnupg/; Gradle finds keys via signing.keyId + signing.password)
# signing.keyId=YOUR_KEY_ID
# signing.password=YOUR_KEY_PASSWORD
# signAllPublications=true

# Optional: override Maven coordinates
# sdkGroup=in.co.niteshkukreja
# sdkVersion=1.0.0
